    <string name="section_advanced_title">Advanced gestures</string>
    <string name="section_advanced_description">Disabled by default. Diagonal gestures require both horizontal and vertical travel to reduce accidental triggers.</string>
    <string name="section_top_title">Top-corner gestures</string>
    <string name="section_top_description">Disabled by default. The zones sit below the status bar and may overlap top app controls.</string>
    <string name="section_hardware_title">Hardware triggers</string>
    <string name="section_hardware_description">Disabled by default. An enabled single-volume-key gesture takes priority over normal volume adjustment for that key.</string>
    <string name="section_tuning_title">Behavior and maintenance</string>
    <string name="section_tuning_description">A wider zone is easier to trigger but can overlap native edge navigation.</string>
