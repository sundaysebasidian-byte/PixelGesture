    <string name="app_name">PixelGesture NextGen Dev</string>
    <string name="accessibility_description">Recognizes configured edge and hardware gestures to run system actions. It does not read screen content or use the network.</string>


    <string name="checking">Checking…</string>


    <string name="open_app_details">Cannot enable it? Open app details</string>
    <string name="restricted_settings_help">If Android shows “Restricted settings,” open App details, tap the top-right menu, allow restricted settings, then return and enable the service. The app does not read screen content or use the network.</string>



