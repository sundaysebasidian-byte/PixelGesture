    <string name="app_name">PixelGesture NextGen Dev</string><string name="accessibility_description">识别已配置的边缘与硬件手势并执行系统动作；不会读取屏幕内容，也不联网。</string>
    <string name="checking">检查中…</string>
    <string name="open_app_details">无法启用？打开应用详情</string>
    <string name="restricted_settings_help">若系统显示“受限设置”，请打开应用详情，点击右上角菜单并允许受限设置，再返回启用服务。应用不读取屏幕内容，也不联网。</string>

    <string name="language_title">语言</string><string name="language_description">默认语言为英语；此选项覆盖应用内全部标签、动作和提示。</string><string name="language_english">English</string><string name="language_chinese">简体中文</string>
